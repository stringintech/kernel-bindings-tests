{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Copies a block",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "request",
    "expected_response"
  ],
  "properties": {
    "description": {
      "$ref": "./shared.json#/$defs/NonEmptyText"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "method",
        "params",
        "ref"
      ],
      "properties": {
        "id": {
          "$ref": "./shared.json#/$defs/TestCaseID"
        },
        "method": {
          "const": "btck_block_copy"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block"
          ],
          "properties": {
            "block": {
              "$ref": "./shared.json#/$defs/RefObject",
              "description": "Block reference from `btck_block_create`"
            }
          }
        },
        "ref": {
          "$ref": "./shared.json#/$defs/RefString"
        }
      }
    },
    "expected_response": {
      "$ref": "./btck_block_copy.response.json"
    }
  }
}
