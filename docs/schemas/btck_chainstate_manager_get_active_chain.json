{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Retrieves the currently active chain from the chainstate manager",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "request",
    "expected_response"
  ],
  "properties": {
    "description": {
      "$ref": "./shared.json#/$defs/NonEmptyText"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "method",
        "params",
        "ref"
      ],
      "properties": {
        "id": {
          "$ref": "./shared.json#/$defs/TestCaseID"
        },
        "method": {
          "const": "btck_chainstate_manager_get_active_chain"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chainstate_manager"
          ],
          "properties": {
            "chainstate_manager": {
              "$ref": "./shared.json#/$defs/RefObject",
              "description": "Chainstate manager reference"
            }
          }
        },
        "ref": {
          "$ref": "./shared.json#/$defs/RefString"
        }
      }
    },
    "expected_response": {
      "$ref": "./btck_chainstate_manager_get_active_chain.response.json"
    }
  }
}
